# ============================================================
# PrintUp — Variables de entorno (plantilla)
# Copiar a .env.local (desarrollo) o .env.sandbox y completar.
# NUNCA commitear los archivos .env reales (ver .gitignore).
# ============================================================

# --- Modo de ejecución --------------------------------------
# "sandbox" = demo, pagos simulados, banner de advertencia visible.
# "produccion" = operación real.
NEXT_PUBLIC_MODO=sandbox

# --- Supabase -----------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# --- Auth Admin / RBAC (CAMBIAR EN PRODUCCIÓN - CRÍTICO) ----
# Bootstrap: estas credenciales SOLO sirven para el primer login mientras la
# tabla usuarios_admin esté vacía. Luego se crean usuarios con rol (admin/
# vendedor/bodega) desde /admin/usuarios y el login se valida contra la BD.
ADMIN_EMAIL=dueno@printup.cl
ADMIN_PASSWORD=Cambia-Esta-Clave-Larga-2026!
# (compatibilidad) usuario semilla legado; se usa ADMIN_EMAIL si está presente.
ADMIN_USER=cambia-este-usuario
# Generar con: openssl rand -hex 32. DEBE ser el mismo valor en toda la app
# (lo usan auth.ts y el middleware para firmar/verificar el JWT del panel).
JWT_SECRET=genera-un-secreto-de-64-hex-aqui

# --- Resend (emails transaccionales) ------------------------
RESEND_API_KEY=re_your_api_key
NOTIFY_TO=pedidos@printup.cl
# En producción debe ser un dominio verificado en Resend (no onboarding@resend.dev)
FROM_EMAIL=pedidos@printup.cl
FROM_NAME=PrintUp

# --- MercadoPago --------------------------------------------
# SANDBOX: usar credenciales TEST-... (no se cobra dinero real).
# PRODUCCIÓN: reemplazar por APP_USR-...
MERCADOPAGO_ACCESS_TOKEN=TEST-xxxxxxxx
MERCADOPAGO_PUBLIC_KEY=TEST-xxxxxxxx
NEXT_PUBLIC_MERCADOPAGO_PUBLIC_KEY=TEST-xxxxxxxx
# Secreto para validar la firma del webhook (Tus integraciones > Webhooks)
MERCADOPAGO_WEBHOOK_SECRET=

# --- App ----------------------------------------------------
# En sandbox: la URL temporal de Vercel. En prod: https://printup.cl
NEXT_PUBLIC_APP_URL=http://localhost:3000

# --- NextCloud (sync worker sube archivos vía WebDAV) -------
NEXTCLOUD_URL=https://printup.internos
NEXTCLOUD_USER=bot-formularios
NEXTCLOUD_PASSWORD=your-app-password
NEXTCLOUD_FOLDER=/PrintUp/Pedidos_Nuevos
NEXTCLOUD_BROWSE_FOLDER=/Shared/PrintUp/Pedidos_Nuevos

# --- Cloudflare R2 (storage de archivos pesados, opcional) --
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=printup-archivos
R2_PUBLIC_URL=

# --- Meta (WhatsApp / Instagram / Facebook webhooks) --------
META_APP_SECRET=
META_VERIFY_TOKEN=

# --- Sentry (monitoreo de errores) --------------------------
# Plan free. Si está vacío, los errores solo van al log del servidor.
NEXT_PUBLIC_SENTRY_DSN=
SENTRY_DSN=

# --- Bot de IA (WhatsApp/IG/FB) -----------------------------
# El bot (src/lib/bot/ai.ts) usa Claude Haiku. Sin esta clave responde solo
# con los flujos por reglas (sin IA para preguntas libres).
ANTHROPIC_API_KEY=

# --- Cron (tareas programadas: carritos abandonados, etc.) --
# Bearer secreto que exige /api/cron/*. Generar con: openssl rand -hex 32
CRON_SECRET=
